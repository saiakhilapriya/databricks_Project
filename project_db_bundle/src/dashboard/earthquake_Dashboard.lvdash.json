      "displayName": "earthquake_detail",
      "queryLines": [
        "select * from saiakhila_dev.silver.earthquake_data_final\r\n"
      ]
    },
    {
      "name": "0ee88a04",
      "displayName": "earthquake_country",
      "queryLines": [
        "--select count(*) as event_count ,split(place,',')[1]  as country from (select time ,title ,mag,longitude,place, latitude from silver.earthquake_data_final ) group by country\r\n",
        "\r\n",
        "select \r\n",
        "  count(*) as event_count,\r\n",
        "  try_element_at(split(place, ','), 2) as country\r\n",
        "from (\r\n",
        "  select time, title, mag, longitude, place, latitude \r\n",
        "  from silver.earthquake_data_final\r\n",
        ")\r\n",
        "group by country"
      ],
      "catalog": "saiakhila_dev",
      "schema": "default"
    }
  ],
